# New Computer Modern Math font
# -----------------------------
# No Latex
#
# visualastro 2026

font.family:         serif
font.serif:          NewComputerModern
font.weight:         400

text.usetex:         False

mathtext.fontset:    cm

axes.unicode_minus:  True

svg.fonttype: path
pdf.fonttype: 42
ps.fonttype:  42
