# Concrete Bold Math font
# -----------------------
# No Latex
#
# visualastro 2026

font.family:         serif
font.serif:          Concrete Math
font.weight:         700

text.usetex:         False

mathtext.fontset:    custom

mathtext.rm:         Concrete Math
mathtext.bf:         Concrete Math
mathtext.it:         Concrete Math
mathtext.sf:         Concrete Math
mathtext.tt:         Concrete Math
mathtext.cal:        Concrete Math
mathtext.fallback:   stix
mathtext.default:    bf

axes.titleweight:    700
axes.labelweight:    700
axes.unicode_minus:  True

figure.titleweight:  700
figure.labelweight:  700

svg.fonttype: path
pdf.fonttype: 42
ps.fonttype:  42
