       " (0.8627450980392157, 0.14901960784313725, 0.4980392156862745),\n",
       " (0.996078431372549, 0.3803921568627451, 0.0),\n",
       " (1.0, 0.6901960784313725, 0.0)]"
      ]
     },
     "execution_count": 12,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "va.get_colors('ibm', fmt='rgb')"
