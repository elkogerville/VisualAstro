   ]
  },
  {
   "cell_type": "markdown",
   "id": "1f64dd7c-1b9b-4978-a6a8-f111958b8b8b",
   "metadata": {},
   "source": [
    "#### Matplotlib Colors"
   ]
  },
  {
   "cell_type": "code",
